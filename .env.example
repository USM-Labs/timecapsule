# Copy to .env and adjust:  cp .env.example .env
# The file is read by phpdotenv. Real environment variables (e.g. from docker-compose)
# always win over this file.

# Only used by docker-compose / documentation; PHP itself does not listen on a port.
APP_PORT=8080
APP_URL=http://localhost:8080
# true = show error details on the 500 page (never in production)
APP_DEBUG=false

# PostgreSQL connection.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timecapsule
DB_USER=timecapsule
DB_PASSWORD=secret

# Attachments are stored in Amazon S3 under the prefix uploads/. No access keys here:
# on EC2 the SDK uses the server's IAM role (instance profile).
S3_BUCKET=timecapsule-dev-uploads-maxsplavski
AWS_REGION=eu-central-1
MAX_UPLOAD_MB=5

# How long the fake "send e-mail" step takes when a capsule is sealed.
MAIL_DELAY_SECONDS=3

# false = no login; everybody uses the app as the built-in Guest user.
AUTH_ENABLED=true
